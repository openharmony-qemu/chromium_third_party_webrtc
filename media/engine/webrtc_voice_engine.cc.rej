diff a/media/engine/webrtc_voice_engine.cc b/media/engine/webrtc_voice_engine.cc	(rejected hunks)
@@ -2655,9 +2655,14 @@ bool WebRtcVoiceReceiveChannel::MaybeCreateDefaultReceiveStream(
   // it up to the *latest* unsignaled stream we've seen, in order to support
   // the case where the SSRC of one unsignaled stream changes.
